        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=3,projectors=2);
        PixelShader      = ps_1_4("ps:TerrainLmapShadow2_Amb.psh");

        VertexShaderConstant[0] = fx_vs_constantsF(0,1);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <lightmap>;
        Texture[3]       = <shadowMap1>;
        Texture[4]       = <shadowmap2>;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        AddressU[4]      = Clamp;
        AddressV[4]      = Clamp;

        TextureTransformFlags[4] = Projected | Count3;
      }

      restorepass
      {
        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        AddressU[4]      = Wrap;
        AddressV[4]      = Wrap;

        TextureTransformFlags[4] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass:  Detail shadow + 2 projected shadow map and ambient
//----------------------------------------------------------

RenderingPass DShadow_OneShadowMap_DetAmb
{
   condition
   {
     Shadows     = 2
     Detail      = true
     Specular    = true
     AmbientCube = true
   }

   technique ps_1_4
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=3,projectors=2);
        PixelShader      = ps_1_4("ps:TerrainLmapShadow2_Amb.psh");

        VertexShaderConstant[0] = fx_vs_constantsF(0,1);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <lightmap>;
        Texture[3]       = <shadowMap1>;
        Texture[4]       = <shadowmap2>;
        Texture[5]       = <detail>;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        AddressU[4]      = Clamp;
        AddressV[4]      = Clamp;

        TextureTransformFlags[4] = Projected | Count3;
      }

      restorepass
      {
        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        AddressU[4]      = Wrap;
        AddressV[4]      = Wrap;

        TextureTransformFlags[4] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass: Projected light pass
//----------------------------------------------------------

Renderingpass Terrain_ProjLight
{
 use "shaders:pass\ProjectionTerrain.rpass"
}

//----------------------------------------------------------
// Pass: Projected light with shadow map
//----------------------------------------------------------

Renderingpass Terrain_ProjLightShadow
{
 use "shaders:pass\ProjectionTerrainShadow.rpass"
}

//----------------------------------------------------------
// SpecialPass: Depth to alpha 
//----------------------------------------------------------

SpecialPass DepthAlpha
{
    use "shaders:pass\DepthAlpha.rpass"
}


