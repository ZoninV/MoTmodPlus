//----------------------------------------------------------
// Terrain shader
//
// Revision: 1.0 Refactored - 02.06.07 Aleksey Agamalov
//----------------------------------------------------------

//----------------------------------------------------------
// Input parameters
//----------------------------------------------------------

public
{
 texture diffuse;
 texture lightmap;
 texture detail;

 texture shadowMap1;
 texture shadowMap2;
}

DefaultRenderPass = BadPass

//----------------------------------------------------------
// Condition shaders
//----------------------------------------------------------

conditions
{
  condition <lightmaped> = "shaders:TerrainLightmaped.sha";
}

//----------------------------------------------------------
// Pass: Bad pass
//----------------------------------------------------------

Renderingpass BadPass
{
  use "shaders:Pass\BadPass.rpass"
}

//----------------------------------------------------------
// Pass: No shadows
//----------------------------------------------------------

RenderingPass NoLight
{
  technique ps_1_1
  {
      pass p0
      {
        PixelShader      = ps_1_1("ps:TerrainNoLight.psh");
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
      }
    }
}

//----------------------------------------------------------
// Pass: Ambient
//----------------------------------------------------------

RenderingPass NoLight_Color
{
  condition
  {
      AmbientCube = true
  }

  technique ps_1_1
  {
      pass p0
      {
        PixelShader      = ps_1_1("ps:TerrainNoLight_Ambient.psh");
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
      }
    }
}

//----------------------------------------------------------
// Pass: No light with detail map
//----------------------------------------------------------

RenderingPass NoLight_Detmap
{ 
  condition
  {
      Specular = true
  }

  technique ps_1_1
  {
      pass p0
      {
        PixelShader      = ps_1_1("ps:TerrainNoLight.psh");
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <detail>;
      }
    }
}

//----------------------------------------------------------
// Pass: No light with detail map and ambient
//----------------------------------------------------------

RenderingPass NoLight_DetmapAmb
{ 
  condition
  {
      Specular    = true
      AmbientCube = true
  }

  technique ps_1_1
  {
      pass p0
      {
        PixelShader      = ps_1_1("ps:TerrainNoLight_Ambient.psh");
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2);

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <detail>;
      }
    }
}

//----------------------------------------------------------
// Pass: Point light 1
//----------------------------------------------------------

RenderingPass Point1
{ 
   condition
   {
      PointLights = 1
   }
   
   technique ps_1_1
   {
      pass p0
      {
        PixelShader              = ps_1_1("ps:TerrainLight.psh");
        VertexShader             = vs_1_1("vs:Terrain.vsh",texcoords=2,pointlights=1);

        Texture[0]               = <diffuse>;
        Texture[1]               = <detail>;

        VertexShaderConstant[14] = fx_vs_constantsF(0,3);
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow
//----------------------------------------------------------

RenderingPass DetailShadow
{
   condition
   {
     Shadows = 1
     Detail  = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=1);
        PixelShader      = ps_1_1("ps:TerrainShadow1.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow
//----------------------------------------------------------

RenderingPass DetailShadow_DMap
{
   condition
   {
     Shadows  = 1
     Detail   = true
     Specular = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=1);
        PixelShader      = ps_1_1("ps:TerrainShadow1.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <detail>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow + 1 projected shadow map
//----------------------------------------------------------

RenderingPass DShadow_OneShadowMap
{
   condition
   {
      Shadows = 2
      Detail  = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=2);
        PixelShader      = ps_1_1("ps:TerrainShadow2.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <shadowmap2>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        TextureTransformFlags[3] = Projected | Count3;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;

        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        TextureTransformFlags[3] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow + 1 projected shadow map
//----------------------------------------------------------

RenderingPass DShadow_OneShadowMap_Det
{
   condition
   {
      Shadows  = 2
      Detail   = true
      Specular = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=2);
        PixelShader      = ps_1_4("ps:TerrainShadow2.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <shadowmap2>;
        Texture[4]       = <detail>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        TextureTransformFlags[3] = Projected | Count3;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;

        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        TextureTransformFlags[3] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow and ambient
//----------------------------------------------------------

RenderingPass DetailShadow_Amb
{
   condition
   {
     Shadows     = 1
     Detail      = true
     AmbientCube = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=1);
        PixelShader      = ps_1_1("ps:TerrainShadow1_Amb.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow, ambient and detail map
//----------------------------------------------------------

RenderingPass DetailShadow_AmbDMap
{
   condition
   {
     Shadows     = 1
     Detail      = true
     AmbientCube = true
     Specular    = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=1);
        PixelShader      = ps_1_1("ps:TerrainShadow1_Amb.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <detail>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow + 2 projected shadow map
//----------------------------------------------------------

RenderingPass DShadow_OneShadowMap_Amb
{
   condition
   {
      Shadows     = 2
      Detail      = true
      AmbientCube = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=2);
        PixelShader      = ps_1_1("ps:TerrainShadow2_Amb.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <shadowmap2>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        TextureTransformFlags[3] = Projected | Count3;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;

        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        TextureTransformFlags[3] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass: Detail shadow + 2 projected shadow map
//----------------------------------------------------------

RenderingPass DShadow_OneShadowMap_DetAmb
{
   condition
   {
      Shadows     = 2
      Detail      = true
      Specular    = true
      AmbientCube = true
   }

   technique ps_1_1
   {
      pass p0
      {
        VertexShader     = vs_1_1("vs:Terrain.vsh",texcoords=2,projectors=2);
        PixelShader      = ps_1_4("ps:TerrainShadow2_Amb.psh");

        Texture[0]       = <diffuse>;
        Texture[1]       = <detail>;
        Texture[2]       = <shadowMap1>;
        Texture[3]       = <shadowmap2>;
        Texture[4]       = <detail>;

        AddressU[2]      = Clamp;
        AddressV[2]      = Clamp;

        AddressU[3]      = Clamp;
        AddressV[3]      = Clamp;

        TextureTransformFlags[3] = Projected | Count3;
      }

      restorepass
      {
        AddressU[2]      = Wrap;
        AddressV[2]      = Wrap;

        AddressU[3]      = Wrap;
        AddressV[3]      = Wrap;

        TextureTransformFlags[3] = TF_Disable;
      }
   }
}

//----------------------------------------------------------
// Pass: Projected light pass
//----------------------------------------------------------

Renderingpass Terrain_ProjLight
{
 use "shaders:pass\ProjectionTerrain.rpass"
}

//----------------------------------------------------------
// Pass: Projected light with shadow map
//----------------------------------------------------------

Renderingpass Terrain_ProjLightShadow
{
 use "shaders:pass\ProjectionTerrainShadow.rpass"
}


//----------------------------------------------------------
// Shadow recieve
//----------------------------------------------------------

SpecialPass ShadowRecieve
{
   use "shaders:pass\ShadowRecieve.rpass"
}

//----------------------------------------------------------
// SpecialPass: Depth to alpha 
//----------------------------------------------------------

SpecialPass DepthAlpha
{
    use "shaders:pass\DepthAlpha.rpass"
}

