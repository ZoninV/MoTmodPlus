//----------------------------------------------------------
// Plants batched shader
//
// Revision: 1.0 Refactored - 28.04.07 Aleksey Agamalov
//----------------------------------------------------------

//----------------------------------------------------------
// Input parameters
//----------------------------------------------------------

DefaultRenderPass = PlantsB_DirLight

//----------------------------------------------------------
// Pass: Directional light 
//----------------------------------------------------------

Renderingpass PlantsB_DirLight
{
  condition
  {
    DirectionalLights = 1
  }

  technique ps_1_1
  {
    pass p0
    {
       PixelShader             = ps_1_1("ps:TexDiffuse.psh");
       VertexShader            = vs_1_1("vs:PlantsBatched.vsh",dirlights=1,fog,deform);

       VertexShaderConstant[0] = static<FogParams>;
       VertexShaderConstant[1] = static<SunDirection>;
       VertexShaderConstant[2] = static<SunLightColors(2)>;
    }
  }
} 

//----------------------------------------------------------
// Pass: Directional light 
//----------------------------------------------------------

Renderingpass TexDirLight_FixBug
{
  condition
  {
    DirectionalLights = 3
  }

  technique ps_1_1
  {
    pass p0
    {
       PixelShader             = ps_1_1("ps:TexDiffuse.psh");
       VertexShader            = vs_1_1("vs:PlantsBatched.vsh",dirlights=1,fog,deform,batched);

       VertexShaderConstant[0] = static<FogParams>;
       VertexShaderConstant[1] = static<SunDirection>;
       VertexShaderConstant[2] = static<SunLightColors(2)>;
    }
  }
} 

//----------------------------------------------------------
// SpecialPass: Shadow color buffer
//----------------------------------------------------------

SpecialPass ShadowColorBuffer	
{
   use "shaders:pass\PlantsShadowBatched.rpass"
}

//----------------------------------------------------------
// SpecialPass: Depth Alpha
//----------------------------------------------------------

SpecialPass DepthAlpha
{
   use "shaders:pass\PlantsDepthDeformBatched.rpass"
}

